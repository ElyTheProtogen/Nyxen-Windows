{
  "name": "nyxenplayer",
  "productName": "NyxenPlayer",
  "version": "1.1.0",
  "description": "NyxenPlayer for Windows: a local-first music player",
  "main": "main.js",
  "author": "NyxenPlayer",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "check": "node --check main.js && node --check preload.js && node --check src/queue-utils.js && node --check src/app.js",
    "test": "node --test"
  },
  "dependencies": {
    "music-metadata": "^10.0.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.nyxen.player",
    "productName": "NyxenPlayer",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "build/icon.png",
      "package.json",
      "resources/**/*"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "NyxenPlayer"
    },
    "fileAssociations": [
      {
        "ext": [
          "mp4",
          "m4v"
        ],
        "name": "MP4 Video",
        "description": "MP4 video file",
        "role": "Viewer",
        "mimeType": "video/mp4"
      }
    ]
  }
}
